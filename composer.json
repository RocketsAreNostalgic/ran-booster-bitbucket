{
    "name": "ran/booster-bitbucket",
    "description": "Bitbucket Cloud provider for RAN Booster.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "support": {
        "issues": "https://github.com/RocketsAreNostalgic/ran-booster-bitbucket/issues",
        "source": "https://github.com/RocketsAreNostalgic/ran-booster-bitbucket"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/RocketsAreNostalgic/ran-coding-standards.git"
        }
    ],
    "extra": {
        "ran-booster-core-candidate": {
            "commit": "ae4de158e3ae02d99162b9b8d0babdc9269a36da"
        },
        "ran-booster-core-certification": {
            "tag": "v1.0.0-beta.29",
            "commit": "ffc11fc8e40618624a785b7fca5193029c6d492e",
            "archive-source-commit": "ff35be100a9f5c6cd77a84bcfc3734227106b0b8"
        },
        "ran-booster-extension": {
            "schema": 1,
            "id": "ran-booster-bitbucket",
            "name": "RAN Booster Bitbucket Cloud",
            "plugin-basename": "ran-booster-bitbucket/ran-booster-bitbucket.php",
            "repository": "https://github.com/RocketsAreNostalgic/ran-booster-bitbucket",
            "update-uri": "https://github.com/RocketsAreNostalgic/ran-booster-bitbucket",
            "availability": "free",
            "requires-wordpress": "7.0",
            "requires-php": "8.2",
            "booster-apis": {
                "required": {
                    "provider": 14,
                    "addon": 17
                },
                "optional": {}
            },
            "maturity": "beta",
            "documentation-uri": "https://github.com/RocketsAreNostalgic/ran-booster-bitbucket#readme",
            "support-uri": "https://github.com/RocketsAreNostalgic/ran-booster-bitbucket/issues",
            "security-uri": "https://github.com/RocketsAreNostalgic/ran-booster-bitbucket/security/policy",
            "readiness": "public-release-required"
        }
    },
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.2.8",
        "szepeviktor/phpstan-wordpress": "^2.0.3",
        "ran/coding-standards": "^1.0",
        "squizlabs/php_codesniffer": "^3.13.5",
        "wp-coding-standards/wpcs": "^3.4",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
        "phpcsstandards/phpcsutils": "^1.2.2",
        "phpcompatibility/phpcompatibility-wp": "^3.0@dev",
        "phpcompatibility/php-compatibility": "^10.0@dev",
        "phpcompatibility/phpcompatibility-paragonie": "^2.0@dev"
    },
    "scripts": {
        "standards": "vendor/bin/phpcs --standard=.phpcs.xml --report=summary",
        "standards:fix": "vendor/bin/phpcbf --standard=.phpcs.xml --report=summary",
        "lint:syntax": "bash scripts/lint-syntax.sh",
        "test:coverage": "bash tests/Workflow/product-php-coverage.sh",
        "test:naming": "bash tests/Workflow/provider-api13-naming.sh",
        "check:coverage": "php scripts/check-product-php-coverage.php",
        "analyze": "vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --no-progress --debug --memory-limit=512M",
        "test": "vendor/bin/phpunit --configuration phpunit.xml",
        "build:release": "bash scripts/build-release.sh",
        "verify:release": "bash scripts/verify-release.sh",
        "check": [
            "@check:coverage",
            "@standards",
            "@lint:syntax",
            "@test:syntax",
            "@test:coverage",
            "@test:naming"
        ],
        "check:host": [
            "@analyze",
            "@test",
            "@test:release-candidate",
            "@check"
        ],
        "test:release-candidate": "bash tests/Workflow/validate-release-candidate.sh",
        "test:syntax": "bash tests/Workflow/lint-syntax.sh"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
