{
    "name": "ran/booster-bitbucket",
    "description": "Bitbucket Cloud provider for RAN Booster.",
    "version": "0.1.0-alpha.2",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "support": {
        "issues": "https://github.com/RocketsAreNostalgic/ran-booster-bitbucket/issues",
        "source": "https://github.com/RocketsAreNostalgic/ran-booster-bitbucket"
    },
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.13.5",
        "wp-coding-standards/wpcs": "^3.4",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
        "phpcsstandards/phpcsutils": "^1.2.2",
        "phpcompatibility/phpcompatibility-wp": "^3.0@dev",
        "phpcompatibility/php-compatibility": "^10.0@dev",
        "phpcompatibility/phpcompatibility-paragonie": "^2.0@dev"
    },
    "scripts": {
        "test:unit": "vendor/bin/phpunit --configuration phpunit.xml",
        "lint:php": "vendor/bin/phpcs --standard=.phpcs.xml --report=summary",
        "lint:php:fix": "vendor/bin/phpcbf --standard=.phpcs.xml --report=summary",
        "lint:syntax": "find . -path ./vendor -prune -o -path ./.phpunit.cache -prune -o -type f -name '*.php' -print0 | xargs -0 -n1 php -l",
        "build:release": "bash scripts/build-release.sh",
        "verify:release": "bash scripts/verify-release.sh",
        "check": [
            "@test:unit",
            "@lint:php",
            "@lint:syntax"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
