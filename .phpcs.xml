<?xml version="1.0"?>
<ruleset name="RAN Booster Bitbucket Coding Standards">
	<description>Product-source standards for the RAN Booster Bitbucket add-on.</description>

	<config name="minimum_supported_wp_version" value="7.0"/>
	<config name="testVersion" value="8.2-"/>

	<file>ran-booster-bitbucket.php</file>
	<file>autoload.php</file>
	<file>src</file>
	<file>views</file>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="4"/>
	<arg value="sp"/>

	<rule ref="RANWordPressPlugin">
		<exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
	</rule>

	<!-- Completed value-object, credential, HTTP, repository, archive, diagnostics and Plugin scope; remaining owned naming is tracked in #63 / organisation #65. -->
	<rule ref="RANOwnedMethods">
		<include-pattern>/src/Bitbucket/BitbucketApiResponse.php</include-pattern>
		<include-pattern>/src/Bitbucket/BitbucketRepositoryCoordinates.php</include-pattern>
		<include-pattern>/src/Bitbucket/BitbucketCredential.php</include-pattern>
		<include-pattern>/src/Bitbucket/BitbucketCredentialLoader.php</include-pattern>
		<include-pattern>/src/Bitbucket/BitbucketCredentialException.php</include-pattern>
		<include-pattern>/src/Bitbucket/BitbucketApiClient.php</include-pattern>
		<include-pattern>/src/Bitbucket/BitbucketApiException.php</include-pattern>
		<include-pattern>/src/Bitbucket/BitbucketRepositoryBrowser.php</include-pattern>
		<include-pattern>/src/Bitbucket/BitbucketArchivePreparer.php</include-pattern>
		<include-pattern>/src/Bitbucket/BitbucketDiagnostics.php</include-pattern>
		<include-pattern>/src/Bitbucket/Plugin.php</include-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<include-pattern>/src/Bitbucket/BitbucketApiResponse.php</include-pattern>
		<include-pattern>/src/Bitbucket/BitbucketRepositoryCoordinates.php</include-pattern>
		<include-pattern>/src/Bitbucket/BitbucketCredential.php</include-pattern>
		<include-pattern>/src/Bitbucket/BitbucketCredentialLoader.php</include-pattern>
		<include-pattern>/src/Bitbucket/BitbucketCredentialException.php</include-pattern>
		<include-pattern>/src/Bitbucket/BitbucketApiClient.php</include-pattern>
		<include-pattern>/src/Bitbucket/BitbucketApiException.php</include-pattern>
		<include-pattern>/src/Bitbucket/BitbucketRepositoryBrowser.php</include-pattern>
		<include-pattern>/src/Bitbucket/BitbucketArchivePreparer.php</include-pattern>
		<include-pattern>/src/Bitbucket/BitbucketDiagnostics.php</include-pattern>
		<include-pattern>/src/Bitbucket/Plugin.php</include-pattern>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ran_booster_bitbucket"/>
				<element value="RAN\\"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedNamespaceFound">
		<severity>0</severity>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<severity>0</severity>
	</rule>
	<rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ran-booster-bitbucket"/>
			</property>
		</properties>
	</rule>
</ruleset>
