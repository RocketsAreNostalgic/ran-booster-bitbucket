<?xml version="1.0"?>
<ruleset name="RAN Booster Bitbucket Coding Standards">
	<description>Maintained PHP standards for the RAN Booster Bitbucket add-on.</description>

	<config name="minimum_supported_wp_version" value="7.0"/>
	<config name="testVersion" value="8.2-"/>

	<file>ran-booster-bitbucket.php</file>
	<file>autoload.php</file>
	<file>index.php</file>
	<file>src</file>
	<file>views</file>
	<file>tests</file>
	<file>scripts</file>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="4"/>
	<arg value="sp"/>

	<rule ref="RANWordPressPlugin"/>

	<!-- Enforce owned methods across all product paths, including future classes with inheritance. -->
	<rule ref="RANOwnedMethods"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ran_booster_bitbucket"/>
				<element value="RAN\\"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ran-booster-bitbucket"/>
			</property>
		</properties>
	</rule>

	<!-- Isolated PHPUnit namespaces follow the test autoload contract; product namespaces remain prefixed. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedNamespaceFound">
		<exclude-pattern>/tests/</exclude-pattern>
	</rule>

	<!-- CLI entry points and disposable installed probes own their process-local variables; local snake_case checks remain active. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>/tests/bootstrap.php</exclude-pattern>
		<exclude-pattern>/tests/phpstan-bootstrap.php</exclude-pattern>
		<exclude-pattern>/tests/fixtures/plugin-lifecycle.php</exclude-pattern>
		<exclude-pattern>/tests/WordPress/</exclude-pattern>
		<exclude-pattern>/scripts/</exclude-pattern>
	</rule>

	<!-- Isolated harnesses define foreign host constants; standalone archive tooling does not load into WordPress. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedConstantFound">
		<exclude-pattern>/tests/bootstrap.php</exclude-pattern>
		<exclude-pattern>/tests/phpstan-bootstrap.php</exclude-pattern>
		<exclude-pattern>/tests/fixtures/plugin-lifecycle.php</exclude-pattern>
		<exclude-pattern>/tests/WordPress/bitbucket-installed-inert.php</exclude-pattern>
		<exclude-pattern>/scripts/verify-release.php</exclude-pattern>
	</rule>

	<!-- Harnesses reproduce native WordPress functions; verifier functions are process-local CLI helpers with snake_case enforcement. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedFunctionFound">
		<exclude-pattern>/tests/bootstrap.php</exclude-pattern>
		<exclude-pattern>/tests/fixtures/plugin-lifecycle.php</exclude-pattern>
		<exclude-pattern>/scripts/verify-release.php</exclude-pattern>
	</rule>

	<!-- Installed probes exercise existing WordPress hooks and must use their exact foreign names. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound">
		<exclude-pattern>/tests/WordPress/</exclude-pattern>
	</rule>
</ruleset>
